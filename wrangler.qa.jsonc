{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "primadom-prima-worker-qa",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api-staging.primadom.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "PRIMA_PERSONA_GENERATIVE_A1": "1",
    "PRIMA_SEARCH_PRODUCTION": "1"
  }
}
