{
  "contract": "PRIMA_ROUTING_SINGLE_TURN_B02",
  "scope": "ONE_INITIAL_MESSAGE_PER_FRESH_CONVERSATION",
  "scenario_count": 10,
  "notes": [
    "Expected route/action hypotheses; ambiguous case judgments require review",
    "Single-turn context tests are intra-message only, NOT multi-turn memory",
    "No lead creation consent; contact cases explicitly disallow CONTACT"
  ],
  "scenarios": [
    {
      "id": "S11",
      "group": "property_search",
      "category": "search_studio_jvc",
      "message": "Find studio apartments in Jumeirah Village Circle for less than AED 900,000.",
      "expected_actions": [
        "SEARCH"
      ],
      "expected_routes": [
        "property_search"
      ],
      "must_not_actions": [
        "CONTACT"
      ]
    },
    {
      "id": "S12",
      "group": "property_search",
      "category": "search_ready_business_bay",
      "message": "Show me ready-to-move-in one-bedroom apartments in Business Bay with a budget of AED 2 million.",
      "expected_actions": [
        "SEARCH"
      ],
      "expected_routes": [
        "property_search"
      ],
      "must_not_actions": [
        "CONTACT"
      ]
    },
    {
      "id": "S13",
      "group": "property_search",
      "category": "search_townhouse_family",
      "message": "Find three-bedroom off-plan townhouses in Dubai under AED 3.5 million, preferably near schools.",
      "expected_actions": [
        "SEARCH"
      ],
      "expected_routes": [
        "property_search"
      ],
      "must_not_actions": [
        "CONTACT"
      ]
    },
    {
      "id": "S14",
      "group": "information",
      "category": "property_ownership_explainer",
