      "expected_actions": [
        "KNOWLEDGE_QA",
        "EXACT_FACT",
        "ADVISORY"
      ],
      "expected_routes": [
        "market_question",
        "exact_fact",
        "page_question",
        "recommendation"
      ],
      "must_not_actions": [
        "SEARCH",
        "CONTACT"
      ]
    },
    {
      "id": "S15",
      "group": "contact_consent",
      "category": "contact_process_no_action",
